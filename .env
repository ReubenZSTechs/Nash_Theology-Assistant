# Model servers
LLM_URL=http://localhost:15000/v1
LLM_MODEL=llm
EMBEDDING_URL=http://localhost:15001/v1
EMBEDDING_MODEL=embedding
VLLM_API_KEY=not-needed
HF_TOKEN=
TRANSCRIBE_URL=http://localhost:15002/v1
TRANSCRIBE_MODEL=whisper-large-v3-turbo
TRANSLATE_URL=http://localhost:15003/v1
TRANSLATE_MODEL=Qwen2.5-14B-Instruct-AWQ

# Embedding configs
EMBED_DIM=1024
EMBED_BATCH=64
EMBED_MAX_TOKENS=8192
EMBED_TIMEOUT=600
EMBED_MAX_RETRIES=3

# Database names
WESTMINSTER_DB=nash_westminster
SERMON_DB=nash_sermons

# Neo4j
NEO4J_URI=bolt://localhost:7687
NEO4J_USERNAME=neo4j
NEO4J_USER=${NEO4J_USERNAME}
NEO4J_PASSWORD=nash-password
NEO4J_HEAP_SIZE=4G
NEO4J_PAGECACHE_SIZE=4G

# Postgres (container setup)
POSTGRES_HOST=localhost
POSTGRES_PORT=5332
POSTGRES_USER=nash
POSTGRES_PASSWORD=nash-password
POSTGRES_DB=nash-database

# Postgres (names the Python code reads)
PG_HOST=${POSTGRES_HOST}
PG_PORT=${POSTGRES_PORT}
PG_USER=${POSTGRES_USER}
PG_PASSWORD=${POSTGRES_PASSWORD}

# pgAdmin
PGADMIN_EMAIL=admin@example.com
PGADMIN_PASSWORD=nash-agentic

# Backend
AUTH_SECRET_KEY=nash-agentic