{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "GraphPooling",
  "type": "object",
  "properties": {
    "reasoning": { "type": "string" },
    "integrated_agents": {
      "type": "array",
      "minItems": 1,
      "maxItems": 5,
      "items": {
        "type": "string",
        "enum": [
          "general_theologian", "systematic_theologian", "biblical_theologian",
          "old_testament_exegete", "new_testament_exegete", "westminster_catechist",
          "church_historian", "comparative_theologian", "apologist", "evangelist",
          "pastor", "ethicist", "devotional_writer", "doctrinal_verifier"
        ]
      }
    },
    "scripture_references": {
      "type": "array",
      "maxItems": 15,
      "items": {
        "type": "object",
        "properties": {
          "reference": { "type": "string" },
          "note": { "type": "string" }
        },
        "required": ["reference", "note"],
        "additionalProperties": false
      }
    },
    "confessional_references": {
      "type": "array",
      "maxItems": 8,
      "items": {
        "type": "object",
        "properties": {
          "document": { "type": "string", "enum": ["WCF", "WLC", "WSC"] },
          "locator": { "type": "string" },
          "note": { "type": "string" }
        },
        "required": ["document", "locator", "note"],
        "additionalProperties": false
      }
    },
    "unresolved_disagreements": {
      "type": "array",
      "maxItems": 4,
      "items": { "type": "string" }
    },
    "answer": { "type": "string" },
    "confidence": { "type": "number", "minimum": 0.0, "maximum": 1.0 }
  },
  "required": ["reasoning", "integrated_agents", "scripture_references", "confessional_references", "unresolved_disagreements", "answer", "confidence"],
  "additionalProperties": false
}