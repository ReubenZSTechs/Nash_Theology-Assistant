{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "HeresyAnalystResponse",
  "type": "object",
  "properties": {
    "reasoning": { "type": "string" },
    "errors_identified": {
      "type": "array",
      "minItems": 1,
      "maxItems": 4,
      "items": {
        "type": "object",
        "properties": {
          "name": { "type": "string" },
          "era": { "type": "string" },
          "description": { "type": "string" },
          "orthodox_response": { "type": "string" }
        },
        "required": ["name", "era", "description", "orthodox_response"],
        "additionalProperties": false
      }
    },
    "doctrines_at_stake": {
      "type": "array",
      "maxItems": 4,
      "items": { "type": "string" }
    },
    "historic_rulings": {
      "type": "array",
      "maxItems": 4,
      "items": { "type": "string" }
    },
    "discernment_tips": {
      "type": "array",
      "maxItems": 3,
      "items": { "type": "string" }
    },
    "scripture_references": {
      "type": "array",
      "minItems": 1,
      "maxItems": 8,
      "items": {
        "type": "object",
        "properties": {
          "reference": { "type": "string" },
          "note": { "type": "string" }
        },
        "required": ["reference", "note"],
        "additionalProperties": false
      }
    },
    "confessional_references": {
      "type": "array",
      "maxItems": 6,
      "items": {
        "type": "object",
        "properties": {
          "document": { "type": "string", "enum": ["WCF", "WLC", "WSC"] },
          "locator": { "type": "string" },
          "note": { "type": "string" }
        },
        "required": ["document", "locator", "note"],
        "additionalProperties": false
      }
    },
    "answer": { "type": "string" },
    "confidence": { "type": "number", "minimum": 0.0, "maximum": 1.0 }
  },
  "required": [
    "reasoning", "errors_identified", "doctrines_at_stake", "historic_rulings", "discernment_tips",
    "scripture_references", "confessional_references", "answer", "confidence"
  ],
  "additionalProperties": false
}