{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "SystematicTheologianResponse",
  "type": "object",
  "properties": {
    "reasoning": { "type": "string" },
    "doctrine_locus": {
      "type": "string",
      "enum": [
        "prolegomena_and_scripture", "theology_proper", "anthropology_and_sin",
        "christology", "soteriology", "pneumatology",
        "ecclesiology_and_sacraments", "eschatology", "covenant_theology"
      ]
    },
    "scripture_references": {
      "type": "array",
      "minItems": 1,
      "maxItems": 12,
      "items": {
        "type": "object",
        "properties": {
          "reference": { "type": "string" },
          "note": { "type": "string" }
        },
        "required": ["reference", "note"],
        "additionalProperties": false
      }
    },
    "confessional_references": {
      "type": "array",
      "maxItems": 8,
      "items": {
        "type": "object",
        "properties": {
          "document": { "type": "string", "enum": ["WCF", "WLC", "WSC"] },
          "locator": { "type": "string" },
          "note": { "type": "string" }
        },
        "required": ["document", "locator", "note"],
        "additionalProperties": false
      }
    },
    "definition": { "type": "string" },
    "key_distinctions": {
      "type": "array",
      "maxItems": 6,
      "items": {
        "type": "object",
        "properties": {
          "term": { "type": "string" },
          "explanation": { "type": "string" }
        },
        "required": ["term", "explanation"],
        "additionalProperties": false
      }
    },
    "related_doctrines": {
      "type": "array",
      "maxItems": 6,
      "items": { "type": "string" }
    },
    "answer": { "type": "string" },
    "confidence": { "type": "number", "minimum": 0.0, "maximum": 1.0 }
  },
  "required": ["reasoning", "doctrine_locus", "scripture_references", "confessional_references", "definition", "key_distinctions", "related_doctrines", "answer", "confidence"],
  "additionalProperties": false
}