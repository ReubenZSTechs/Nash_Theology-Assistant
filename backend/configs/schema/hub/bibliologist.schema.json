{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "BibliologistResponse",
  "type": "object",
  "properties": {
    "reasoning": { "type": "string" },
    "scripture_topic": {
      "type": "string",
      "enum": [
        "inspiration", "inerrancy", "authority", "sufficiency", "clarity", "necessity", "canon",
        "text_and_manuscripts", "translation", "illumination"
      ]
    },
    "attributes_involved": {
      "type": "array",
      "maxItems": 4,
      "items": { "type": "string" }
    },
    "objections_answered": {
      "type": "array",
      "maxItems": 3,
      "items": {
        "type": "object",
        "properties": {
          "objection": { "type": "string" },
          "response": { "type": "string" }
        },
        "required": ["objection", "response"],
        "additionalProperties": false
      }
    },
    "evidence_notes": {
      "type": "array",
      "maxItems": 4,
      "items": { "type": "string" }
    },
    "scripture_references": {
      "type": "array",
      "minItems": 1,
      "maxItems": 8,
      "items": {
        "type": "object",
        "properties": {
          "reference": { "type": "string" },
          "note": { "type": "string" }
        },
        "required": ["reference", "note"],
        "additionalProperties": false
      }
    },
    "confessional_references": {
      "type": "array",
      "maxItems": 6,
      "items": {
        "type": "object",
        "properties": {
          "document": { "type": "string", "enum": ["WCF", "WLC", "WSC"] },
          "locator": { "type": "string" },
          "note": { "type": "string" }
        },
        "required": ["document", "locator", "note"],
        "additionalProperties": false
      }
    },
    "answer": { "type": "string" },
    "confidence": { "type": "number", "minimum": 0.0, "maximum": 1.0 }
  },
  "required": [
    "reasoning", "scripture_topic", "attributes_involved", "objections_answered", "evidence_notes",
    "scripture_references", "confessional_references", "answer", "confidence"
  ],
  "additionalProperties": false
}