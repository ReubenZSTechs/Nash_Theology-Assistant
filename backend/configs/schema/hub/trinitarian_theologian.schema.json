{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "TrinitarianTheologianResponse",
  "type": "object",
  "properties": {
    "reasoning": { "type": "string" },
    "doctrine_area": {
      "type": "string",
      "enum": ["trinity", "attributes", "names_of_god", "decrees", "creation", "providence", "mixed"]
    },
    "attributes_involved": {
      "type": "array",
      "maxItems": 5,
      "items": { "type": "string" }
    },
    "distinctions": {
      "type": "array",
      "maxItems": 4,
      "items": {
        "type": "object",
        "properties": {
          "term": { "type": "string" },
          "explanation": { "type": "string" }
        },
        "required": ["term", "explanation"],
        "additionalProperties": false
      }
    },
    "errors_to_avoid": {
      "type": "array",
      "maxItems": 3,
      "items": { "type": "string" }
    },
    "scripture_references": {
      "type": "array",
      "minItems": 1,
      "maxItems": 8,
      "items": {
        "type": "object",
        "properties": {
          "reference": { "type": "string" },
          "note": { "type": "string" }
        },
        "required": ["reference", "note"],
        "additionalProperties": false
      }
    },
    "confessional_references": {
      "type": "array",
      "maxItems": 6,
      "items": {
        "type": "object",
        "properties": {
          "document": { "type": "string", "enum": ["WCF", "WLC", "WSC"] },
          "locator": { "type": "string" },
          "note": { "type": "string" }
        },
        "required": ["document", "locator", "note"],
        "additionalProperties": false
      }
    },
    "answer": { "type": "string" },
    "confidence": { "type": "number", "minimum": 0.0, "maximum": 1.0 }
  },
  "required": [
    "reasoning", "doctrine_area", "attributes_involved", "distinctions", "errors_to_avoid",
    "scripture_references", "confessional_references", "answer", "confidence"
  ],
  "additionalProperties": false
}