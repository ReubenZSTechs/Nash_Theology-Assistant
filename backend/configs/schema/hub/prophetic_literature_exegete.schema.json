{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "PropheticLiteratureExegeteResponse",
  "type": "object",
  "properties": {
    "reasoning": { "type": "string" },
    "prophet_or_book": { "type": "string" },
    "historical_occasion": { "type": "string" },
    "oracle_type": {
      "type": "string",
      "enum": ["judgment", "salvation", "covenant_lawsuit", "lament", "apocalyptic_vision", "mixed"]
    },
    "fulfilment": {
      "type": "array",
      "maxItems": 4,
      "items": {
        "type": "object",
        "properties": {
          "stage": {
            "type": "string",
            "enum": ["near_historical", "first_coming_of_christ", "church_age", "consummation"]
          },
          "explanation": { "type": "string" }
        },
        "required": ["stage", "explanation"],
        "additionalProperties": false
      }
    },
    "scripture_references": {
      "type": "array",
      "minItems": 1,
      "maxItems": 8,
      "items": {
        "type": "object",
        "properties": {
          "reference": { "type": "string" },
          "note": { "type": "string" }
        },
        "required": ["reference", "note"],
        "additionalProperties": false
      }
    },
    "confessional_references": {
      "type": "array",
      "maxItems": 6,
      "items": {
        "type": "object",
        "properties": {
          "document": { "type": "string", "enum": ["WCF", "WLC", "WSC"] },
          "locator": { "type": "string" },
          "note": { "type": "string" }
        },
        "required": ["document", "locator", "note"],
        "additionalProperties": false
      }
    },
    "answer": { "type": "string" },
    "confidence": { "type": "number", "minimum": 0.0, "maximum": 1.0 }
  },
  "required": [
    "reasoning", "prophet_or_book", "historical_occasion", "oracle_type", "fulfilment",
    "scripture_references", "confessional_references", "answer", "confidence"
  ],
  "additionalProperties": false
}