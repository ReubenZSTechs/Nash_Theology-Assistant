{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "GospelsScholarResponse",
  "type": "object",
  "properties": {
    "reasoning": { "type": "string" },
    "gospel": { "type": "string", "enum": ["Matthew", "Mark", "Luke", "John", "multiple"] },
    "parallel_passages": {
      "type": "array",
      "maxItems": 4,
      "items": { "type": "string" }
    },
    "literary_context": { "type": "string" },
    "gospel_emphasis": { "type": "string" },
    "harmonization_note": { "type": "string" },
    "scripture_references": {
      "type": "array",
      "minItems": 1,
      "maxItems": 8,
      "items": {
        "type": "object",
        "properties": {
          "reference": { "type": "string" },
          "note": { "type": "string" }
        },
        "required": ["reference", "note"],
        "additionalProperties": false
      }
    },
    "confessional_references": {
      "type": "array",
      "maxItems": 6,
      "items": {
        "type": "object",
        "properties": {
          "document": { "type": "string", "enum": ["WCF", "WLC", "WSC"] },
          "locator": { "type": "string" },
          "note": { "type": "string" }
        },
        "required": ["document", "locator", "note"],
        "additionalProperties": false
      }
    },
    "answer": { "type": "string" },
    "confidence": { "type": "number", "minimum": 0.0, "maximum": 1.0 }
  },
  "required": [
    "reasoning", "gospel", "parallel_passages", "literary_context", "gospel_emphasis",
    "harmonization_note", "scripture_references", "confessional_references", "answer",
    "confidence"
  ],
  "additionalProperties": false
}