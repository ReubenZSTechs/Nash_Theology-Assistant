{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "WestminsterCatechistResponse",
  "type": "object",
  "properties": {
    "reasoning": { "type": "string" },
    "confessional_references": {
      "type": "array",
      "minItems": 1,
      "maxItems": 10,
      "items": {
        "type": "object",
        "properties": {
          "document": { "type": "string", "enum": ["WCF", "WLC", "WSC"] },
          "locator": { "type": "string" },
          "note": { "type": "string" }
        },
        "required": ["document", "locator", "note"],
        "additionalProperties": false
      }
    },
    "scripture_references": {
      "type": "array",
      "minItems": 1,
      "maxItems": 12,
      "items": {
        "type": "object",
        "properties": {
          "reference": { "type": "string" },
          "note": { "type": "string" }
        },
        "required": ["reference", "note"],
        "additionalProperties": false
      }
    },
    "catechetical_breakdown": {
      "type": "array",
      "minItems": 1,
      "maxItems": 5,
      "items": {
        "type": "object",
        "properties": {
          "question": { "type": "string" },
          "answer": { "type": "string" }
        },
        "required": ["question", "answer"],
        "additionalProperties": false
      }
    },
    "plain_explanation": { "type": "string" },
    "answer": { "type": "string" },
    "confidence": { "type": "number", "minimum": 0.0, "maximum": 1.0 }
  },
  "required": ["reasoning", "confessional_references", "scripture_references", "catechetical_breakdown", "plain_explanation", "answer", "confidence"],
  "additionalProperties": false
}