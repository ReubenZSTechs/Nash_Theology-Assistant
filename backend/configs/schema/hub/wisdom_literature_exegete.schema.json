{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "WisdomLiteratureExegeteResponse",
  "type": "object",
  "properties": {
    "reasoning": { "type": "string" },
    "book": {
      "type": "string",
      "enum": ["Job", "Psalms", "Proverbs", "Ecclesiastes", "Song of Songs", "multiple", "other"]
    },
    "poetic_features": {
      "type": "array",
      "maxItems": 4,
      "items": { "type": "string" }
    },
    "wisdom_theme": { "type": "string" },
    "christ_connection": { "type": "string" },
    "scripture_references": {
      "type": "array",
      "minItems": 1,
      "maxItems": 8,
      "items": {
        "type": "object",
        "properties": {
          "reference": { "type": "string" },
          "note": { "type": "string" }
        },
        "required": ["reference", "note"],
        "additionalProperties": false
      }
    },
    "confessional_references": {
      "type": "array",
      "maxItems": 6,
      "items": {
        "type": "object",
        "properties": {
          "document": { "type": "string", "enum": ["WCF", "WLC", "WSC"] },
          "locator": { "type": "string" },
          "note": { "type": "string" }
        },
        "required": ["document", "locator", "note"],
        "additionalProperties": false
      }
    },
    "answer": { "type": "string" },
    "confidence": { "type": "number", "minimum": 0.0, "maximum": 1.0 }
  },
  "required": [
    "reasoning", "book", "poetic_features", "wisdom_theme", "christ_connection", "scripture_references",
    "confessional_references", "answer", "confidence"
  ],
  "additionalProperties": false
}