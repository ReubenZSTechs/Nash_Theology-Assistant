{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "PneumatologistResponse",
  "type": "object",
  "properties": {
    "reasoning": { "type": "string" },
    "spirit_topic": {
      "type": "string",
      "enum": [
        "person_and_deity", "work_in_creation", "inspiration_and_illumination", "regeneration_and_indwelling",
        "sanctification", "assurance", "gifts", "baptism_and_filling"
      ]
    },
    "gifts_discussed": {
      "type": "array",
      "maxItems": 5,
      "items": { "type": "string" }
    },
    "continuationism_cessationism_note": { "type": "string" },
    "errors_to_avoid": {
      "type": "array",
      "maxItems": 3,
      "items": { "type": "string" }
    },
    "scripture_references": {
      "type": "array",
      "minItems": 1,
      "maxItems": 8,
      "items": {
        "type": "object",
        "properties": {
          "reference": { "type": "string" },
          "note": { "type": "string" }
        },
        "required": ["reference", "note"],
        "additionalProperties": false
      }
    },
    "confessional_references": {
      "type": "array",
      "maxItems": 6,
      "items": {
        "type": "object",
        "properties": {
          "document": { "type": "string", "enum": ["WCF", "WLC", "WSC"] },
          "locator": { "type": "string" },
          "note": { "type": "string" }
        },
        "required": ["document", "locator", "note"],
        "additionalProperties": false
      }
    },
    "answer": { "type": "string" },
    "confidence": { "type": "number", "minimum": 0.0, "maximum": 1.0 }
  },
  "required": [
    "reasoning", "spirit_topic", "gifts_discussed", "continuationism_cessationism_note",
    "errors_to_avoid", "scripture_references", "confessional_references", "answer", "confidence"
  ],
  "additionalProperties": false
}