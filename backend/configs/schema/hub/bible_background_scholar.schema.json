{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "BibleBackgroundScholarResponse",
  "type": "object",
  "properties": {
    "reasoning": { "type": "string" },
    "historical_setting": { "type": "string" },
    "background_facts": {
      "type": "array",
      "minItems": 1,
      "maxItems": 6,
      "items": {
        "type": "object",
        "properties": {
          "category": {
            "type": "string",
            "enum": ["geography", "history", "culture", "customs", "religion", "archaeology", "language"]
          },
          "fact": { "type": "string" },
          "relevance": { "type": "string" }
        },
        "required": ["category", "fact", "relevance"],
        "additionalProperties": false
      }
    },
    "caution": { "type": "string" },
    "scripture_references": {
      "type": "array",
      "minItems": 1,
      "maxItems": 8,
      "items": {
        "type": "object",
        "properties": {
          "reference": { "type": "string" },
          "note": { "type": "string" }
        },
        "required": ["reference", "note"],
        "additionalProperties": false
      }
    },
    "confessional_references": {
      "type": "array",
      "maxItems": 6,
      "items": {
        "type": "object",
        "properties": {
          "document": { "type": "string", "enum": ["WCF", "WLC", "WSC"] },
          "locator": { "type": "string" },
          "note": { "type": "string" }
        },
        "required": ["document", "locator", "note"],
        "additionalProperties": false
      }
    },
    "answer": { "type": "string" },
    "confidence": { "type": "number", "minimum": 0.0, "maximum": 1.0 }
  },
  "required": [
    "reasoning", "historical_setting", "background_facts", "caution", "scripture_references",
    "confessional_references", "answer", "confidence"
  ],
  "additionalProperties": false
}