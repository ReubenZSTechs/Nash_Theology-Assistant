{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "EvangelistResponse",
  "type": "object",
  "properties": {
    "reasoning": { "type": "string" },
    "audience_assumption": { "type": "string" },
    "scripture_references": {
      "type": "array",
      "minItems": 1,
      "maxItems": 8,
      "items": {
        "type": "object",
        "properties": {
          "reference": { "type": "string" },
          "note": { "type": "string" }
        },
        "required": ["reference", "note"],
        "additionalProperties": false
      }
    },
    "gospel_outline": {
      "type": "object",
      "properties": {
        "god_and_creation": { "type": "string" },
        "sin_and_judgment": { "type": "string" },
        "christ_and_cross": { "type": "string" },
        "repentance_and_faith": { "type": "string" }
      },
      "required": ["god_and_creation", "sin_and_judgment", "christ_and_cross", "repentance_and_faith"],
      "additionalProperties": false
    },
    "barriers_addressed": {
      "type": "array",
      "maxItems": 4,
      "items": {
        "type": "object",
        "properties": {
          "barrier": { "type": "string" },
          "response": { "type": "string" }
        },
        "required": ["barrier", "response"],
        "additionalProperties": false
      }
    },
    "call_to_response": { "type": "string" },
    "answer": { "type": "string" },
    "confidence": { "type": "number", "minimum": 0.0, "maximum": 1.0 }
  },
  "required": ["reasoning", "audience_assumption", "scripture_references", "gospel_outline", "barriers_addressed", "call_to_response", "answer", "confidence"],
  "additionalProperties": false
}