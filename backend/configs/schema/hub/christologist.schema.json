{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "ChristologistResponse",
  "type": "object",
  "properties": {
    "reasoning": { "type": "string" },
    "christ_aspect": {
      "type": "string",
      "enum": [
        "person", "two_natures", "incarnation", "offices", "humiliation", "exaltation", "atonement",
        "union_with_christ"
      ]
    },
    "offices_involved": {
      "type": "array",
      "maxItems": 3,
      "items": { "type": "string", "enum": ["prophet", "priest", "king"] }
    },
    "historical_definitions": {
      "type": "array",
      "maxItems": 3,
      "items": { "type": "string" }
    },
    "errors_to_avoid": {
      "type": "array",
      "maxItems": 3,
      "items": { "type": "string" }
    },
    "scripture_references": {
      "type": "array",
      "minItems": 1,
      "maxItems": 8,
      "items": {
        "type": "object",
        "properties": {
          "reference": { "type": "string" },
          "note": { "type": "string" }
        },
        "required": ["reference", "note"],
        "additionalProperties": false
      }
    },
    "confessional_references": {
      "type": "array",
      "maxItems": 6,
      "items": {
        "type": "object",
        "properties": {
          "document": { "type": "string", "enum": ["WCF", "WLC", "WSC"] },
          "locator": { "type": "string" },
          "note": { "type": "string" }
        },
        "required": ["document", "locator", "note"],
        "additionalProperties": false
      }
    },
    "answer": { "type": "string" },
    "confidence": { "type": "number", "minimum": 0.0, "maximum": 1.0 }
  },
  "required": [
    "reasoning", "christ_aspect", "offices_involved", "historical_definitions", "errors_to_avoid",
    "scripture_references", "confessional_references", "answer", "confidence"
  ],
  "additionalProperties": false
}