{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "SoteriologistResponse",
  "type": "object",
  "properties": {
    "reasoning": { "type": "string" },
    "ordo_salutis_steps": {
      "type": "array",
      "minItems": 1,
      "maxItems": 5,
      "items": {
        "type": "string",
        "enum": [
          "election", "effectual_calling", "regeneration", "faith", "repentance", "justification",
          "adoption", "sanctification", "perseverance", "assurance", "glorification"
        ]
      }
    },
    "distinctions": {
      "type": "array",
      "maxItems": 4,
      "items": {
        "type": "object",
        "properties": {
          "term": { "type": "string" },
          "explanation": { "type": "string" }
        },
        "required": ["term", "explanation"],
        "additionalProperties": false
      }
    },
    "assurance_note": { "type": "string" },
    "scripture_references": {
      "type": "array",
      "minItems": 1,
      "maxItems": 8,
      "items": {
        "type": "object",
        "properties": {
          "reference": { "type": "string" },
          "note": { "type": "string" }
        },
        "required": ["reference", "note"],
        "additionalProperties": false
      }
    },
    "confessional_references": {
      "type": "array",
      "maxItems": 6,
      "items": {
        "type": "object",
        "properties": {
          "document": { "type": "string", "enum": ["WCF", "WLC", "WSC"] },
          "locator": { "type": "string" },
          "note": { "type": "string" }
        },
        "required": ["document", "locator", "note"],
        "additionalProperties": false
      }
    },
    "answer": { "type": "string" },
    "confidence": { "type": "number", "minimum": 0.0, "maximum": 1.0 }
  },
  "required": [
    "reasoning", "ordo_salutis_steps", "distinctions", "assurance_note", "scripture_references",
    "confessional_references", "answer", "confidence"
  ],
  "additionalProperties": false
}