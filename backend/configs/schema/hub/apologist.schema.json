{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "ApologistResponse",
  "type": "object",
  "properties": {
    "reasoning": { "type": "string" },
    "objection_summary": { "type": "string" },
    "apologetic_method": {
      "type": "string",
      "enum": ["presuppositional", "classical", "evidential", "cumulative_case"]
    },
    "scripture_references": {
      "type": "array",
      "maxItems": 10,
      "items": {
        "type": "object",
        "properties": {
          "reference": { "type": "string" },
          "note": { "type": "string" }
        },
        "required": ["reference", "note"],
        "additionalProperties": false
      }
    },
    "arguments": {
      "type": "array",
      "minItems": 1,
      "maxItems": 6,
      "items": {
        "type": "object",
        "properties": {
          "claim": { "type": "string" },
          "support": { "type": "string" }
        },
        "required": ["claim", "support"],
        "additionalProperties": false
      }
    },
    "anticipated_counters": {
      "type": "array",
      "maxItems": 4,
      "items": {
        "type": "object",
        "properties": {
          "counter": { "type": "string" },
          "reply": { "type": "string" }
        },
        "required": ["counter", "reply"],
        "additionalProperties": false
      }
    },
    "answer": { "type": "string" },
    "confidence": { "type": "number", "minimum": 0.0, "maximum": 1.0 }
  },
  "required": ["reasoning", "objection_summary", "apologetic_method", "scripture_references", "arguments", "anticipated_counters", "answer", "confidence"],
  "additionalProperties": false
}