{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "GeneralTheologianResponse",
  "type": "object",
  "properties": {
    "reasoning": { "type": "string" },
    "scripture_references": {
      "type": "array",
      "maxItems": 10,
      "items": {
        "type": "object",
        "properties": {
          "reference": { "type": "string" },
          "note": { "type": "string" }
        },
        "required": ["reference", "note"],
        "additionalProperties": false
      }
    },
    "confessional_references": {
      "type": "array",
      "maxItems": 6,
      "items": {
        "type": "object",
        "properties": {
          "document": { "type": "string", "enum": ["WCF", "WLC", "WSC"] },
          "locator": { "type": "string" },
          "note": { "type": "string" }
        },
        "required": ["document", "locator", "note"],
        "additionalProperties": false
      }
    },
    "key_points": {
      "type": "array",
      "minItems": 1,
      "maxItems": 6,
      "items": { "type": "string" }
    },
    "answer": { "type": "string" },
    "confidence": { "type": "number", "minimum": 0.0, "maximum": 1.0 }
  },
  "required": ["reasoning", "scripture_references", "confessional_references", "key_points", "answer", "confidence"],
  "additionalProperties": false
}