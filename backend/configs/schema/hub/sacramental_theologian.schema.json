{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "SacramentalTheologianResponse",
  "type": "object",
  "properties": {
    "reasoning": { "type": "string" },
    "sacrament": { "type": "string", "enum": ["baptism", "lords_supper", "both", "sacraments_in_general"] },
    "sign": { "type": "string" },
    "thing_signified": { "type": "string" },
    "proper_recipients": { "type": "string" },
    "common_misunderstandings": {
      "type": "array",
      "maxItems": 4,
      "items": { "type": "string" }
    },
    "scripture_references": {
      "type": "array",
      "minItems": 1,
      "maxItems": 8,
      "items": {
        "type": "object",
        "properties": {
          "reference": { "type": "string" },
          "note": { "type": "string" }
        },
        "required": ["reference", "note"],
        "additionalProperties": false
      }
    },
    "confessional_references": {
      "type": "array",
      "maxItems": 6,
      "items": {
        "type": "object",
        "properties": {
          "document": { "type": "string", "enum": ["WCF", "WLC", "WSC"] },
          "locator": { "type": "string" },
          "note": { "type": "string" }
        },
        "required": ["document", "locator", "note"],
        "additionalProperties": false
      }
    },
    "answer": { "type": "string" },
    "confidence": { "type": "number", "minimum": 0.0, "maximum": 1.0 }
  },
  "required": [
    "reasoning", "sacrament", "sign", "thing_signified", "proper_recipients", "common_misunderstandings",
    "scripture_references", "confessional_references", "answer", "confidence"
  ],
  "additionalProperties": false
}