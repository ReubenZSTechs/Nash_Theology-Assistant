{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "EthicistResponse",
  "type": "object",
  "properties": {
    "reasoning": { "type": "string" },
    "ethical_issue": { "type": "string" },
    "commandments": {
      "type": "array",
      "maxItems": 3,
      "items": {
        "type": "string",
        "enum": ["first", "second", "third", "fourth", "fifth", "sixth", "seventh", "eighth", "ninth", "tenth"]
      }
    },
    "scripture_references": {
      "type": "array",
      "minItems": 1,
      "maxItems": 10,
      "items": {
        "type": "object",
        "properties": {
          "reference": { "type": "string" },
          "note": { "type": "string" }
        },
        "required": ["reference", "note"],
        "additionalProperties": false
      }
    },
    "confessional_references": {
      "type": "array",
      "maxItems": 6,
      "items": {
        "type": "object",
        "properties": {
          "document": { "type": "string", "enum": ["WCF", "WLC", "WSC"] },
          "locator": { "type": "string" },
          "note": { "type": "string" }
        },
        "required": ["document", "locator", "note"],
        "additionalProperties": false
      }
    },
    "principles": {
      "type": "array",
      "minItems": 1,
      "maxItems": 6,
      "items": {
        "type": "object",
        "properties": {
          "principle": { "type": "string" },
          "basis": { "type": "string" }
        },
        "required": ["principle", "basis"],
        "additionalProperties": false
      }
    },
    "christian_liberty_note": { "type": "string" },
    "practical_guidance": {
      "type": "array",
      "minItems": 1,
      "maxItems": 5,
      "items": { "type": "string" }
    },
    "answer": { "type": "string" },
    "confidence": { "type": "number", "minimum": 0.0, "maximum": 1.0 }
  },
  "required": ["reasoning", "ethical_issue", "commandments", "scripture_references", "confessional_references", "principles", "christian_liberty_note", "practical_guidance", "answer", "confidence"],
  "additionalProperties": false
}