{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "ScienceAndFaithScholarResponse",
  "type": "object",
  "properties": {
    "reasoning": { "type": "string" },
    "topic": {
      "type": "string",
      "enum": [
        "creation_and_origins", "age_of_the_earth", "evolution", "human_origins", "miracles",
        "cosmology", "scientific_method", "other"
      ]
    },
    "reformed_views": {
      "type": "array",
      "maxItems": 4,
      "items": {
        "type": "object",
        "properties": {
          "view": { "type": "string" },
          "summary": { "type": "string" },
          "assessment": { "type": "string" }
        },
        "required": ["view", "summary", "assessment"],
        "additionalProperties": false
      }
    },
    "scientific_considerations": {
      "type": "array",
      "maxItems": 4,
      "items": { "type": "string" }
    },
    "points_of_agreement": { "type": "string" },
    "certainty_level": {
      "type": "string",
      "enum": ["clearly_taught", "confessionally_settled", "debated_among_reformed"]
    },
    "scripture_references": {
      "type": "array",
      "minItems": 1,
      "maxItems": 8,
      "items": {
        "type": "object",
        "properties": {
          "reference": { "type": "string" },
          "note": { "type": "string" }
        },
        "required": ["reference", "note"],
        "additionalProperties": false
      }
    },
    "confessional_references": {
      "type": "array",
      "maxItems": 6,
      "items": {
        "type": "object",
        "properties": {
          "document": { "type": "string", "enum": ["WCF", "WLC", "WSC"] },
          "locator": { "type": "string" },
          "note": { "type": "string" }
        },
        "required": ["document", "locator", "note"],
        "additionalProperties": false
      }
    },
    "answer": { "type": "string" },
    "confidence": { "type": "number", "minimum": 0.0, "maximum": 1.0 }
  },
  "required": [
    "reasoning", "topic", "reformed_views", "scientific_considerations", "points_of_agreement",
    "certainty_level", "scripture_references", "confessional_references", "answer", "confidence"
  ],
  "additionalProperties": false
}