{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "MarriageAndSexualityEthicistResponse",
  "type": "object",
  "properties": {
    "reasoning": { "type": "string" },
    "topic": {
      "type": "string",
      "enum": [
        "marriage", "singleness", "dating_and_courtship", "divorce_and_remarriage", "sexual_ethics",
        "gender", "family_and_children"
      ]
    },
    "principles": {
      "type": "array",
      "minItems": 1,
      "maxItems": 5,
      "items": {
        "type": "object",
        "properties": {
          "principle": { "type": "string" },
          "basis": { "type": "string" }
        },
        "required": ["principle", "basis"],
        "additionalProperties": false
      }
    },
    "pastoral_sensitivity_note": { "type": "string" },
    "practical_guidance": {
      "type": "array",
      "minItems": 1,
      "maxItems": 4,
      "items": { "type": "string" }
    },
    "recommend_in_person_care": { "type": "boolean" },
    "scripture_references": {
      "type": "array",
      "minItems": 1,
      "maxItems": 8,
      "items": {
        "type": "object",
        "properties": {
          "reference": { "type": "string" },
          "note": { "type": "string" }
        },
        "required": ["reference", "note"],
        "additionalProperties": false
      }
    },
    "confessional_references": {
      "type": "array",
      "maxItems": 6,
      "items": {
        "type": "object",
        "properties": {
          "document": { "type": "string", "enum": ["WCF", "WLC", "WSC"] },
          "locator": { "type": "string" },
          "note": { "type": "string" }
        },
        "required": ["document", "locator", "note"],
        "additionalProperties": false
      }
    },
    "answer": { "type": "string" },
    "confidence": { "type": "number", "minimum": 0.0, "maximum": 1.0 }
  },
  "required": [
    "reasoning", "topic", "principles", "pastoral_sensitivity_note", "practical_guidance",
    "recommend_in_person_care", "scripture_references", "confessional_references", "answer",
    "confidence"
  ],
  "additionalProperties": false
}