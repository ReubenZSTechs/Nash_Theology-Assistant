{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "DevotionalWriterResponse",
  "type": "object",
  "properties": {
    "reasoning": { "type": "string" },
    "title": { "type": "string" },
    "theme": { "type": "string" },
    "key_verse": {
      "type": "object",
      "properties": {
        "reference": { "type": "string" },
        "text": { "type": "string" }
      },
      "required": ["reference", "text"],
      "additionalProperties": false
    },
    "scripture_references": {
      "type": "array",
      "maxItems": 5,
      "items": {
        "type": "object",
        "properties": {
          "reference": { "type": "string" },
          "note": { "type": "string" }
        },
        "required": ["reference", "note"],
        "additionalProperties": false
      }
    },
    "answer": { "type": "string" },
    "application": { "type": "string" },
    "prayer": { "type": "string" },
    "reflection_questions": {
      "type": "array",
      "minItems": 1,
      "maxItems": 3,
      "items": { "type": "string" }
    },
    "confidence": { "type": "number", "minimum": 0.0, "maximum": 1.0 }
  },
  "required": ["reasoning", "title", "theme", "key_verse", "scripture_references", "answer", "application", "prayer", "reflection_questions", "confidence"],
  "additionalProperties": false
}