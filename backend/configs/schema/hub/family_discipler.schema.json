{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "FamilyDisciplerResponse",
  "type": "object",
  "properties": {
    "reasoning": { "type": "string" },
    "audience": {
      "type": "string",
      "enum": ["young_children", "older_children", "teenagers", "whole_family", "parents"]
    },
    "simple_explanation": { "type": "string" },
    "discussion_questions": {
      "type": "array",
      "minItems": 1,
      "maxItems": 4,
      "items": { "type": "string" }
    },
    "family_activities": {
      "type": "array",
      "maxItems": 4,
      "items": { "type": "string" }
    },
    "memory_verse": { "type": "string" },
    "scripture_references": {
      "type": "array",
      "minItems": 1,
      "maxItems": 8,
      "items": {
        "type": "object",
        "properties": {
          "reference": { "type": "string" },
          "note": { "type": "string" }
        },
        "required": ["reference", "note"],
        "additionalProperties": false
      }
    },
    "confessional_references": {
      "type": "array",
      "maxItems": 6,
      "items": {
        "type": "object",
        "properties": {
          "document": { "type": "string", "enum": ["WCF", "WLC", "WSC"] },
          "locator": { "type": "string" },
          "note": { "type": "string" }
        },
        "required": ["document", "locator", "note"],
        "additionalProperties": false
      }
    },
    "answer": { "type": "string" },
    "confidence": { "type": "number", "minimum": 0.0, "maximum": 1.0 }
  },
  "required": [
    "reasoning", "audience", "simple_explanation", "discussion_questions", "family_activities",
    "memory_verse", "scripture_references", "confessional_references", "answer", "confidence"
  ],
  "additionalProperties": false
}